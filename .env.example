# 数据库配置
ENVIRONMENT=development
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>

# JWT 配置
SECRET_KEY=<generate-with-python-secrets-token-hex-32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 配置（多个源用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# 视频存储配置
VIDEO_STORAGE_BACKEND=local
VIDEO_UPLOAD_DIR=uploads/videos

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=10MB
LOG_RETENTION=7days
LOG_FORMAT=text

# MoveNet 姿态分析（默认关闭；启用前需安装可兼容当前 Python 的 OpenCV、NumPy 和 TFLite 运行时）
# 模型必须是 float16/float32 版本，int8 量化模型会被运行时拒绝（返回 503）而不是产出错误关键点。
MOVENET_ENABLED=false
MOVENET_MODEL_PATH=
MOVENET_MODEL_VARIANT=thunder
MOVENET_MIN_CONFIDENCE=0.3
MOVENET_SAMPLE_FPS=5

# 异步姿态分析任务活性超时（秒）：服务重启或推理超过该时长的 queued/running 任务
# 会被标为 failed 并释放记录，可重新发起分析。
POSE_ANALYSIS_JOB_STALE_AFTER_SECONDS=1800
# 单进程部署下启动时立即回收遗留任务；如果改成多 worker 共库请设为 false。
POSE_ANALYSIS_JOB_RECLAIM_ON_STARTUP=true
