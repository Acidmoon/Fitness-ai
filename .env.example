# Copy configuration through your deployment's secret manager or process environment.
# This example intentionally contains no working credentials or encryption keys.
# The application does not automatically load .env files.
FITNESS_USERS_ENABLED=false
FITNESS_DATABASE_URL=
FITNESS_DATABASE_MIGRATION_URL=
FITNESS_DATABASE_TLS=verify-full
FITNESS_DATABASE_CA_FILE=
FITNESS_DATABASE_POOL_MAX=10
FITNESS_DATABASE_STATEMENT_TIMEOUT_MS=10000
FITNESS_DATABASE_TRANSACTION_TIMEOUT_MS=30000
FITNESS_USER_ENCRYPTION_KEYS=
FITNESS_USER_ENCRYPTION_ACTIVE_KEY=
FITNESS_USER_LOOKUP_KEY=

# HTTP entry point (pnpm serve). The video root must be set explicitly; no default.
FITNESS_HTTP_HOST=127.0.0.1
FITNESS_HTTP_PORT=8787
FITNESS_VIDEO_ROOT=

# Account system. FITNESS_TENANT_ID is required when authentication is enabled;
# there is no default tenant and no fallback.
FITNESS_TENANT_ID=
FITNESS_AUTH_SESSION_HOURS=168
FITNESS_AUTH_MAX_ATTEMPTS=5
FITNESS_AUTH_LOCK_MINUTES=15

# Video upload (POST /api/uploads). The temp area lives under FITNESS_VIDEO_ROOT/_uploads.
FITNESS_UPLOAD_MAX_BYTES=536870912
FITNESS_UPLOAD_TTL_MINUTES=120
# Set to false ONLY for local demos; anonymous uploads are not for deployment.
FITNESS_UPLOAD_REQUIRE_AUTH=true

# Skeleton GIF on-demand rendering cache (in-memory LRU byte cap; 0 disables caching).
FITNESS_SKELETON_CACHE_BYTES=8388608

# Android in-app update manifest (GET /api/app/android/latest). Leave empty when disabled.
FITNESS_APP_RELEASES_FILE=

# Local integration testing only; point to an existing PostgreSQL 16+ bin directory.
FITNESS_TEST_PG_BIN=
