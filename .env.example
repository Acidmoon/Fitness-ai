# Copy configuration through your deployment's secret manager or process environment.
# This example intentionally contains no working credentials or encryption keys.
# The application does not automatically load .env files.
FITNESS_USERS_ENABLED=false
FITNESS_DATABASE_URL=
FITNESS_DATABASE_MIGRATION_URL=
FITNESS_DATABASE_TLS=verify-full
FITNESS_DATABASE_CA_FILE=
FITNESS_DATABASE_POOL_MAX=10
FITNESS_DATABASE_STATEMENT_TIMEOUT_MS=10000
FITNESS_DATABASE_TRANSACTION_TIMEOUT_MS=30000
FITNESS_USER_ENCRYPTION_KEYS=
FITNESS_USER_ENCRYPTION_ACTIVE_KEY=
FITNESS_USER_LOOKUP_KEY=

# Local integration testing only; point to an existing PostgreSQL 16+ bin directory.
FITNESS_TEST_PG_BIN=
