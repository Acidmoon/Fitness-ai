# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/fitness_ai

# JWT 配置
SECRET_KEY=your-random-secret-key-here-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 配置（多个源用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=10MB
LOG_RETENTION=7days
LOG_FORMAT=text

# MoveNet 姿态分析（默认关闭；启用前需安装可兼容当前 Python 的 OpenCV、NumPy 和 TFLite 运行时）
MOVENET_ENABLED=false
MOVENET_MODEL_PATH=
MOVENET_MODEL_VARIANT=thunder
MOVENET_MIN_CONFIDENCE=0.3
MOVENET_SAMPLE_FPS=5
