# === 生产环境配置模板 ===
# 复制为 .env.production 并填入真实值
# 生成 SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=production

# 数据库（Docker 内部网络）
POSTGRES_USER=fitness
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fitness_ai
DATABASE_URL=postgresql://fitness:CHANGE_ME@db:5432/fitness_ai

# JWT
SECRET_KEY=CHANGE_ME_TO_A_REAL_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=https://fitness.waterhill.cyou,https://api-fitness.waterhill.cyou

# 视频存储
VIDEO_STORAGE_BACKEND=local
VIDEO_UPLOAD_DIR=uploads/videos

# 日志
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
LOG_FORMAT=text

# 姿态分析
POSE_ANALYSIS_BACKEND=movenet
POSE_ANALYSIS_SAMPLE_FPS=5
MOVENET_ENABLED=true
MOVENET_MODEL_PATH=/app/models/movenet_lightning.tflite
MOVENET_MODEL_VARIANT=lightning
MOVENET_MIN_CONFIDENCE=0.3
MOVENET_SAMPLE_FPS=5
